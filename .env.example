# ── LLM 后端配置 ──────────────────────────────────────────────
# 选择后端:
#   ollama    — 本地大模型（路线 A 城北卡通版默认，零 Key）
#   dashscope — 阿里百炼 qwen3-max（路线 B 小忆真人版用这个）
#   gateway   — OpenAI 兼容中转网关
LLM_PROVIDER=ollama

# ── 阿里百炼配置（真人版「小忆」核心，LLM_PROVIDER=dashscope 时生效）──
# 一个 Key 管全部云端能力：qwen3-max 对话 / cosyvoice-v2 语音 /
# wanx2.1-t2i-turbo 文生图 / emo-detect-v1 + emo-v1 对口型视频 / 照片上传
# 获取方式：https://bailian.console.aliyun.com → 右上角 API-KEY → 创建（华北2-北京）
# ⚠️ EMO（悦动人像）大概率需要在模型广场单独申请开通，没开通时对口型自动降级、其余功能正常
DASHSCOPE_API_KEY=sk-your-key-here

# ── Ollama 配置（LLM_PROVIDER=ollama 时生效）─────────────────
# Ollama 服务地址（默认本机）
OLLAMA_BASE=http://localhost:11434
# 要用的模型名，需提前 ollama pull 下载
# qwen2.5:0.5b（约 400MB）下载快、能立刻跑通，适合先验证；
# 想要更好的对话质量改成 qwen2.5:7b（约 4.7GB）再 ollama pull 一次即可。
OLLAMA_MODEL=qwen2.5:0.5b

# ── 中转网关配置（LLM_PROVIDER=gateway 时生效）───────────────
# 你的中转网关 OpenAI 兼容 base URL
GATEWAY_BASE=https://gw.diaoye.org/v1
# 你的 API Key
GATEWAY_KEY=your-api-key-here
# 要用的模型名
GATEWAY_MODEL=claude-sonnet-4-5

# ── 服务端口 ──────────────────────────────────────────────────
PORT=3000

# ── 两端版（子女端 × 父母端）配置 ───────────────────────────────
# 一套代码两个入口：/#/child（子女端控制台）/ /#/parent（父母端适老化流）。
#
# 双口令 CHILD_CODE / PARENT_CODE —— 谁带哪个口令进来就是哪个角色：
#   带 CHILD_CODE  → 子女端（建分身、回信、看账单）
#   带 PARENT_CODE → 父母端（聊天、求助、收回信）
# 与老 ACCESS_CODE 的兼容关系（向后兼容，老配置不用改）：
#   - 三者任一被显式配置 → 进入「口令模式」（公网部署用，无口令访问 401）；
#   - 只设了老 ACCESS_CODE、没设 CHILD_CODE/PARENT_CODE → ACCESS_CODE 自动当作
#     子女端邀请码的回落默认值，等效原 ACCESS_CODE 口令，行为不变；
#   - CHILD_CODE 缺省回落 ACCESS_CODE，再缺省 'dev-child'；PARENT_CODE 在口令模式下
#     未设置则随机生成（打印在启动日志，防默认值被猜），仅本地裸跑才缺省 'dev-parent'；
#     公网部署建议显式设置 PARENT_CODE；
#   - 三者全不配置 → 本地裸跑：默认子女端，前端按路由带 X-Twin-Role 头切角色，零口令。
# 邀请链接格式：把带口令的完整链接发给对方，例如
#   父母端：https://你的域名/?code=父母口令#/parent
#   子女端：https://你的域名/?code=子女口令#/child
CHILD_CODE=
PARENT_CODE=

# 额度护栏：单家庭每自然月可生成的对口型视频秒数上限，超出后回信/话术库降级为纯语音
# （不烧额度）。默认 300 秒/月。
QUOTA_VIDEO_SECONDS=300

# 家庭数据库文件路径（可选）：存家庭/成员/收件箱/额度。默认 data/family.db，
# 支持绝对路径（如 /tmp/x.db）与相对项目根的相对路径，方便测试时隔离。已 gitignore。
# FAMILY_DB=data/family.db

# ── TTS 语音合成配置（阶段 1）────────────────────────────────
# 是否开启 TTS（true / false），默认开启
TTS_ENABLED=true
# TTS 引擎选择：say（macOS 内置，零依赖，开箱即用）或 kokoro（本地高质量）
TTS_PROVIDER=say
# TTS 音色
# say 模式推荐：Tingting（普通话女声），Meijia（台湾女声），Eddy（普通话男声）
# kokoro 模式推荐：zf_xiaoxiao（中文女声），zm_yunxi（中文男声）
TTS_VOICE=Tingting
# kokoro 模式专用：Python FastAPI 服务地址（启动 tts_server.py 后默认在这里）
TTS_SERVICE_URL=http://127.0.0.1:8000

# ── ASR 语音识别配置（阶段 2）────────────────────────────────
# 是否开启语音按钮（true / false），默认开启
ASR_ENABLED=true
# ASR 引擎选择：
#   webspeech — 浏览器原生 Web Speech API（零依赖，Chrome 直接用；大陆连不上谷歌，不可用）
#   whisper   — 本地 mlx-whisper（高质量离线识别，需要起 asr_server.py，仅 Apple Silicon）
#   dashscope — 百炼 qwen3-asr-flash 云端识别（用上面的 DASHSCOPE_API_KEY；
#               在线部署/不想装 Python 时用这个，0.00022 元/秒、送 10 小时）
ASR_PROVIDER=webspeech
# whisper 模式专用：Python FastAPI 服务地址（启动 asr_server.py 后默认在这里）
ASR_SERVICE_URL=http://127.0.0.1:8001
# whisper 模式专用：mlx-whisper 模型（首次使用会自动下载，约 1.5GB）
ASR_MODEL=mlx-community/whisper-large-v3-turbo

# ── 记忆层配置（阶段 4）──────────────────────────────────────
# 是否开启记忆功能（true / false），默认开启
MEMORY_ENABLED=true
# SQLite 数据库文件路径（相对于项目根目录），已加入 .gitignore
MEMORY_DB=data/memory.db
# Ollama embedding 模型（用于向量检索，首次使用会自动下载，约 274MB）
# 如果模型没就绪，系统会自动降级到关键词匹配，不影响基础使用
EMBED_MODEL=nomic-embed-text
# 每次检索注入的记忆条数（太多会增加延迟并让城北"过度熟悉"，3-5 条最佳）
MEMORY_TOPK=4

# ── 语音打断配置（阶段 5）────────────────────────────────────
# 是否开启语音打断（barge-in）：城北说话时用户开口可打断 TTS（true / false）
# 实现：TTS 播放期间持续检测麦克风音量，连续多帧超阈值就触发打断
BARGE_IN_ENABLED=true

# ── 唤醒词配置（阶段 5）──────────────────────────────────────
# 是否开启常驻唤醒词监听（true / false）
# 开启后浏览器持续监听，喊"城北"即可触发对话（麦克风常开，有隐私提示）
WAKE_WORD_ENABLED=true
# 触发唤醒的关键词（逗号分隔，大小写不敏感）
# 注意：Web Speech API 识别"城北"时请保持唤醒词配置一致
WAKE_WORDS=城北

# ── 形象 Provider 配置（阶段 6）──────────────────────────────
# 选择形象渲染引擎：
#   live2d    — 本地 Live2D 卡通形象「城北」（默认，Mac 本地开箱即用）
#   realhuman — 云端真人写实形象「小忆」（走阿里百炼，需要上面的 DASHSCOPE_API_KEY）
#
# 真人版「小忆」完整配置 = 下面这四行（前置条件见 README 路线 B）：
#   LLM_PROVIDER=dashscope
#   AVATAR_PROVIDER=realhuman
#   DASHSCOPE_API_KEY=sk-你的key
#   ASR_PROVIDER=whisper（语音输入，需先起 asr_server.py；只打字可不配）
# 形象支持两种来源：提示词文生图，或在「设置→形象图片」上传自己的照片
AVATAR_PROVIDER=live2d

# （历史遗留，可忽略）自建 LiveTalking 云主机方案的服务地址，现行实现不需要
REALHUMAN_SERVICE_URL=

# ── 对口型视频 Provider（真人版，三选一）─────────────────────
# 对口型视频后端: emo | omnihuman | seedance（运行中可在设置页热切换，详见 README「三路视频 provider」）
#   emo       — 阿里 EMO（默认，用上面的 DASHSCOPE_API_KEY，月免费 1800 秒，超出 0.08~0.16 元/秒）
#   omnihuman — 字节 OmniHuman（火山引擎「即梦·数字人快速模式」，约 1 元/秒，480P）
#   seedance  — 字节 Seedance 2.0（火山方舟，约 1 元/秒 @720p，生成式运镜效果）
VIDEO_PROVIDER=emo

# —— OmniHuman（火山引擎，AK/SK 签名）——
# 获取方式：火山引擎控制台 https://console.volcengine.com → 右上角头像 → 「API访问密钥」
#（先在「即梦AI」能力页开通「数字人快速模式」，见 README；⚠️ 按视频时长计费约 1 元/秒）
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# —— Seedance 2.0（火山方舟，Bearer key）——
# 获取方式：火山方舟控制台 https://console.volcengine.com/ark → 「API Key 管理」→ 创建
#（先在「开通管理」开通下面的 Seedance 模型；⚠️ 720p 约 1 元/秒）
ARK_API_KEY=
# Seedance 模型 ID：doubao-seedance-2-0-260128（标准版）；
# 想便宜些可换 doubao-seedance-2-0-fast-260128（快速版，约 0.8 元/秒 @720p）
SEEDANCE_MODEL=doubao-seedance-2-0-260128

# ── 真人版话术库命中配置（可选微调）──────────────────────────
# 语义命中开关：让「意思相近、用词不同」的回复也命中已缓存的对口型视频。
# 默认关——nomic-embed-text 对含相同名字的中文短句相似度虚高，易误命中播错视频；
# 要开建议先 ollama pull bge-m3 并把上面 EMBED_MODEL 一起换掉
SPEAK_SEMANTIC=false
# 语义命中相似度阈值（0~1，越高越严格）
SPEAK_MATCH_THRESHOLD=0.75
