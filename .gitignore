node_modules/
# 所有 .env 变体一律不进库（.env.local / .env.bak 等都可能含真实 key，开源仓决不能漏）
.env
.env.*
*.env.bak
# 但放行配置模板（学员需要它当样板复制成 .env，里面只有占位符）
!.env.example

# Python 虚拟环境（体积大，本地各自创建）
.venv-tts/
.venv-asr/
__pycache__/
*.pyc

# 记忆数据库（阶段 4：包含用户隐私数据，不进库）
data/

# Serena MCP 项目缓存（工具产物，不进库）
.serena/

# 前端旧版本地备份（Live2D 城北版快照；旧版本身在 git 历史里可追溯）
public/index.live2d.bak.html

# 本地缓存的形象图（运行时从 DashScope 下载，不进库）
public/avatars/

# Vue 构建产物（npm run build 产出，不进库）
dist/
docs/*-单文件版.html
